<Window
    x:Class="GWCT.Notify"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:GWCT"
    mc:Ignorable="d"
    Width="400"
    Height="auto"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    Style="{StaticResource WindowStyle}">
    <WindowChrome.WindowChrome>
        <StaticResource
            ResourceKey="WindowChromeStyle" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush
            x:Key="DarkBlue"
            Color="#FF333D4C" />
    </Window.Resources>
    <Grid>
        <Grid
            Height="30"
            VerticalAlignment="Top"
            Background="{StaticResource DarkBlue}"
            x:Name="TITLE"
            Panel.ZIndex="2">
            <Border
                Margin="0,0,1,0"
                Style="{StaticResource CloseButton}"
                x:Name="CLOSE">
                <Path
                    Data="M0 0L10 10M0 10L10 0"
                    Style="{StaticResource ButtonPath}" />
            </Border>
        </Grid>
        <Grid
            Margin="0,30,0,0"
            x:Name="MainArea"
            ClipToBounds="True"
            Panel.ZIndex="1">
            <Border
                Background="{StaticResource DimBg}"
                CornerRadius="5"
                Margin="10"
                Padding="5">
                <TextBlock
                    VerticalAlignment="Top"
                    TextAlignment="Left"
                    TextWrapping="Wrap"
                    Text=""
                    Foreground="{StaticResource WhiteText}"
                    x:Name="InfoStd">
                </TextBlock>
            </Border>
            <Border
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Background="{StaticResource DarkBg}"
                BorderBrush="{StaticResource DarkBorder}"
                BorderThickness="2"
                CornerRadius="5"
                Width="25"
                Height="25"
                Margin="15">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="i"
                    Foreground="{StaticResource Blue}"
                    x:Name="IconStd">
                </TextBlock>
            </Border>
        </Grid>
        <Grid.Effect>
            <StaticResource
                ResourceKey="HeavyShadow"/>
        </Grid.Effect>
    </Grid>
</Window>
